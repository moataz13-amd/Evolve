{
  "name": "@evolve/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cloudinary:secrets": "node --env-file=.env scripts/cloudinary.mjs secrets",
    "cloudinary:deploy": "node --env-file=.env scripts/cloudinary.mjs deploy",
    "cloudinary:serve": "node --env-file=.env scripts/cloudinary.mjs serve",
    "test": "node --test tests/*.test.js",
    "db:init": "supabase init",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:link": "node --env-file=.env scripts/database.mjs link",
    "db:push": "node --env-file=.env scripts/database.mjs push",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:homepage:restore": "node --env-file=../frontend/.env --env-file=.env scripts/restore-homepage.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "supabase": "^2.120.0"
  }
}
